# Autonomous Open Corpus Harvester: harvested blobs, normalized text,
# licence artifacts, metadata sidecars, quarantine dossiers, locks, and
# reports. Content-addressed and potentially very large -- reconstructible
# from the database and the source catalogues, never committed.
data/corpus/

# Automatically harvested corpus, materialized into the reserved _auto
# subdirectories. Already covered by data/books/* and data/manifestos/*
# above; named explicitly so the intent is obvious.
data/books/_auto/
data/manifestos/_auto/
