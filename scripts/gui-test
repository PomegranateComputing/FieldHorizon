#!/usr/bin/env bash
set -euo pipefail

# Frontend test suite (Phase UI-3 item 6 fills in the real tests; today
# `npm test` is a clearly-labeled placeholder rather than a faked pass).

cd "$(git rev-parse --show-toplevel)/apps/desktop"

if [ ! -d node_modules ]; then
    echo "installing frontend dependencies (node_modules missing)..." >&2
    npm install
fi

npm test
